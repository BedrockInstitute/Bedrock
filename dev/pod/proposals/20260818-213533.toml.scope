# Maintainer batch 20260818-213533. THE BATCH IS EMPTY AND THE REASON IS NAMED.
#
# `harvest_batch()` reads `row` and `queue` and nothing else. This file carries
# neither, so the program writes a `batch` line with `result: "empty"` at
# `scripts/pod/pod.py:2029` and renames the file to `<name>.toml.empty` at
# `scripts/pod/pod.py:1948`. The reason below is kept with it.
#
# THE ONE PARKED TASK: LJ-1.386, `reason: "launch"`.
#
# 1. NO ROW CAN ROUTE THIS PARK, because the router never sees it.
#    `dev/pod/transitions/2026-08.jsonl` seq 2 records `READY -> PARKED` with
#    `reason: "launch"` and no `record` key: exit_code, error_class and
#    obligations_delta are all absent and 0 files changed. Rule (a2) at
#    `scripts/pod/pod.py:2488` takes `admission` and `launch` in a branch ABOVE
#    the `t.record is None` test at `:2492` and above `_route()` at `:2496`, and
#    it un-parks on one test only: `dev/pod/table.toml` is newer than
#    `parked_at`. A `[row.when]` block is matched against the seven facts, and
#    this park has none of them, so a row admitted for it could never fire.
#
# 2. THE CAUSE IS A PROGRAM DEFECT AND IT IS IDENTIFIED, so no row is the cure.
#    `launch()` at `scripts/pod/pod.py:1663` passes `preamble=` and `provider=`.
#    The `--plan` stub at HEAD pins the signature and accepts neither:
#    `git show HEAD:scripts/pod/pod.py` line 2615 reads
#    `def launch(task, brief, agda, sandbox, model, effort="", tier="wide"):`.
#    The TypeError is caught at `scripts/pod/pod.py:1669`, `launch()` returns
#    None, and rule (f) parks with `reason: "launch"` at `:2704`. The same
#    TypeError is logged verbatim for the refill at seq 3 and seq 4 of
#    `dev/pod/transitions/2026-08.jsonl`.
#
# 3. THE DEFECT IS ALREADY CURED IN THE WORKING TREE and the cure is not
#    committed. `scripts/pod/pod.py:2861` now reads
#    `def launch(task, brief, agda, sandbox, model, effort="", tier="wide", **kw)`.
#    Its comment records the same failure class MEASURED 2026-08-18 for
#    `resident=`. No row and no `[[queue]]` request is needed: the park un-parks
#    at the next table write, and the next real dispatch takes the cured stub.
#
# 4. NO `[[queue]]` REQUEST. Section 6.7 of `dev/memos/LJ-4-pod-program-design.md`
#    admits a brief-repair request for a `preflight:` or a `no-change` park. This
#    park is `launch`, the brief was never read, and the brief is not at fault.
#
# TWO CONDITIONS THE NEXT BATCH MUST KNOW, both measured now:
#
# A. THE REPLAY GATE IS CURRENTLY EMPTY. `dev/pod/replay-corpus.jsonl` is 0
#    lines, so `replay()` at `scripts/pod/pod.py:2038` moves no record and
#    returns ADMIT for any well-formed row. R3 rejects nothing today. A wrong
#    row would enter the tracked table unopposed, which is the exact condition
#    the "say so and stop" clause exists for.
#
# B. THIS BATCH CANNOT BE ADMITTED FROM THIS TREE. `maintainer_scope_ok()` at
#    `scripts/pod/pod.py:1934` reads `git status --porcelain
#    --untracked-files=all` and refuses on any path outside the proposal, the
#    three `PROGRAM_WRITES` prefixes, a retired suffix and a `/.pod` suffix. The
#    tree carries 16 modified tracked files and the untracked paths
#    `dev/pod/direction.md`, `scripts/pod/keeper.sh`,
#    `scripts/tests/test_pod_keeper.py` and
#    `agents/tasks/LJ-1-386/ [conflicted].pod`. The last one ends with `.pod` but
#    not with `/.pod`, so the exemption at `:1938` does not cover it. The batch
#    will report `result: "scope"` before it reads this file's contents.

[batch]
ts = "20260818-213533"
rows_proposed = 0
reason = "The one parked task is parked at `launch`, which rule (a2) resolves above the router, and its cause is a program defect already cured in the working tree. No row can route a record that does not exist."
