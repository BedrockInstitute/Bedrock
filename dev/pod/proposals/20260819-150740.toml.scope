# Maintainer batch 20260819-150740. ONE ROW PROPOSED, AND TWO SHAPES NAMED AND STOPPED.
#
# THE THREE PARKED TASKS ARE NOT ONE PROBLEM. They are three, and only one of them
# is a routing gap a row can close.
#
# 1. LJ-1.388, `no-match`: exit_code 1, error_class `lint`, obligations_delta -2.
#    **THE MATHEMATICS LANDED AND THE REPORT DID NOT.** Conjunct 6 failed on
#    `check-survey-quotes.py LJ-1.388`, which is task-scoped: the return carries no
#    ARCHIVE USED section and no LITERATURE USED section. The five whole-tree linters
#    all pass. So the run is green in substance, `obligations_delta` reached the
#    branch's own `-2`, and only `exit_code = 0` is missing. No row covers it.
#    THE ROW BELOW COVERS IT, and `accept` is the honest action: a form defect in a
#    return is repaired by asking the same head once more, and `attempt_max` caps the
#    loop at 4 by B2.
#
# 2. LJ-1.386, `no-match`: exit_code 0, error_class None, obligations_delta 0.
#    **NO ROW. THE SHAPE IS AMBIGUOUS AND A WRONG ROW HERE CLOSES REAL WORK.** See
#    below.
#
# 3. LJ-1.390, `no-change`: R7 fired and there is NO record at all.
#    **NO ROW CAN EVER REACH IT.** `route()` is called on a record and this park has
#    none. It is not a routing gap and the batch must not pretend otherwise.

[[row]]
id = "sys-lint-accept"
scope = "system"
priority = 120
action = "accept"
added = 2026-08-19
added_by = "maintainer"
reason = "A lint failure is a defect in the RETURN and not in the mathematics, so the head is asked once more to repair it. Basis: LJ-1.388 reached obligations_delta -2 and failed only conjunct 6."
expired = false

  [row.when]
  error_class = "lint"

# ---------------------------------------------------------------------------
# WHAT I WILL NOT WRITE, AND WHY. My slot's clause: a row I am unsure of enters a
# TRACKED table and steers every later task, so an empty answer with a named reason
# costs nothing and a wrong row costs a rollback.
#
# THE SHAPE: exit_code 0, error_class None, obligations_delta 0, and files changed.
# In plain words, a GREEN run that wrote files and discharged no obligation.
#
# IT HAS TWO READINGS AND THE FACTS DO NOT SEPARATE THEM.
#
#   (a) THE TASK WAS ALREADY COMPLETE. This is what LJ-1.386 actually is: its FIRST
#       run returned GO and discharged both obligations, acceptance then failed on a
#       spec-surface move that was NOT its doing, so it never closed. The re-run
#       measured `obl_before = 0` and could not reach -2 again. Correct action:
#       `done`.
#
#   (b) THE WORKER WROTE AND ACHIEVED NOTHING. Correct action: never `done`.
#
# **R7 NO LONGER SEPARATES THEM EITHER.** Its dead-worker guard fires when fact 4 is
# EMPTY, and both readings write files, so both reach acceptance with a record.
#
# A `done` row on this shape would close reading (b) as a success, which is the one
# error this table must not make.
#
# THE OWNER'S RULING IS ASKED ON ONE OF TWO CANDIDATES:
#
#   ROW A, escalate. `exit_code = 0`, `obligations_delta` 0 to 0, `heap_wall = false`,
#   and NO `seconds_min`. It is `sys-slow-green-empty` with the 300 s floor removed,
#   so a second reader prices the return instead of the table guessing. It closes
#   nothing wrongly. It costs one dispatch per occurrence.
#
#   ROW B, done. The same `when`, action `done`. It closes LJ-1.386 today and it will
#   eventually close a task that achieved nothing.
#
# I recommend ROW A. It is the same treatment the table already gives the SLOW form
# of this exact shape, and the only thing the 300 s floor was ever measuring is how
# long the waste took.
#
# ONE MORE THING THE OWNER SHOULD SEE, and it is not a row.
# **A `no-change` PARK IS UNREACHABLE BY ANY ROW, AND IT HAPPENED TODAY.** LJ-1.390
# delivered GO, its work was committed, and its re-run then wrote nothing, so R7
# parked it with no record. Rule (a2) needs a record to re-route and there is none,
# so the task is parked until a person moves it. This is the third permanent-park
# shape found on 2026-08-19; the other two are fixed. It needs a ruling and not a row.

[batch]
ts = "20260819-150740"
rows_proposed = 1
reason = "One row for the `lint` gap, which is mechanical. The green-and-empty shape is STOPPED with two candidate rows named for the owner, because its two readings differ only in intent and a `done` row would close a task that achieved nothing. The `no-change` park carries no record and no row can reach it."
