scope = "task:LJ-1.636"
priority = 9
action = "done"
outcome = "go"
added = 2026-08-27
added_by = "maintainer"
reason = "Corrects task-lj-1-636-go (priority 10, this table), which keys on obligations_delta_max=-1 and will miss on any future fresh dispatch: Probe636.agda is already green on disk, so a fresh dispatch's obl_before reads 0 and the delta is 0, not -1 (amendment A23's named defect, scripts/pod/witness.py:510-520). obligations_open_max=0 is fact 8, added by A23 for exactly this shape (scripts/pod/table.py:97-103). pod-math's diagnosis, relayed and independently verified: witness_unresolved() (scripts/pod/pod.py:5622) recomputes obl_before fresh at every dispatch. Priority 9 so this row is checked ahead of the now-superseded priority-10 row, which is left in place rather than edited."
expired = false

  [row.when]
  exit_code = 0
  obligations_open_max = 0
  heap_wall = false

