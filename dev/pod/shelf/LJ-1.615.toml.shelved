  "agents/tasks/LJ-1-615/review-of-value-is-L.md:1",
  "agents/tasks/LJ-1-615/LJ-1.615.md:42",
  "agents/tasks/LJ-1-611/lj-1.611-report.md:79",
  "agents/tasks/LJ-1-533/lj-1.533-report.md:76",
]
reopen = "Reopen if TransferL is delivered, or if a later proof gives ValueIsL by a route that does not pass through an ambient-to-inner transfer. Face G- of LJ-1.606's crossing is the consumer, so a reopen also follows if that face is restated in a form the recovered factorization does reach. Not 'try it again and see'."
by = "mathematician"
