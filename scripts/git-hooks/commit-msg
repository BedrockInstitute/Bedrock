#!/bin/sh
# Bedrock commit-msg: the AGENTS.md guard (ruling D34). A commit that stages
# AGENTS.md must carry the owner's dated approval trailer:
#     AGENTS-diff-approved: YYYY-MM-DD
# The orchestrator adds the trailer only after the owner ruled on the diff.
# Bypass in an emergency with: git commit --no-verify

PY=python3
[ -x .venv/bin/python ] && PY=.venv/bin/python

exec $PY scripts/check-agents-guard.py --msg-file "$1"
