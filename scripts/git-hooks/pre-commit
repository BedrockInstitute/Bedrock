#!/bin/sh
# Bedrock pre-commit: fast, source-level checks on staged Markdown only (no Agda, no site
# build). Enforces prose conventions (full-width CJK punctuation, 「」 quotes, half-width
# Chinese parens, no em dash, no single quotes / nesting) and i18n marker integrity.
# Activated via: git config --local core.hooksPath scripts/git-hooks   (or: make hooks)
# Bypass in an emergency with: git commit --no-verify

# Use the project virtualenv interpreter (Python 3.11+, has tomllib for the glossary
# checker); fall back to python3 if .venv is absent (then run `make venv`).
PY=python3
[ -x .venv/bin/python ] && PY=.venv/bin/python

# The never-commit gate runs FIRST and on its own: a probe or a generated file in the
# index is not a style problem to report alongside others, it is a commit to stop.
# .gitignore is a default that `git add -f` walks past; this is the gate.
if ! $PY scripts/check-probes.py --staged; then
	echo ""
	echo "Never-commit rule violated (AGENTS.md Never list; dev/LESSONS.md D-1)."
	echo "(To bypass in a genuine emergency: git commit --no-verify)"
	exit 1
fi

md=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(md|lagda\.md)$')
masters=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.lagda\.md$')

status=0

if [ -n "$md" ]; then
	# shellcheck disable=SC2086
	if ! $PY scripts/lint-prose.py --check $md; then
		echo ""
		echo "Prose lint failed. Auto-fix punctuation/quotes with:"
		echo "    $PY scripts/lint-prose.py --fix $md"
		echo "Em dashes, single quotes, and quote nesting must be rewritten by hand."
		status=1
	fi
fi

if [ -n "$masters" ]; then
	# shellcheck disable=SC2086
	if ! $PY scripts/weave-i18n.py --check $masters; then
		echo ""
		echo "i18n marker check failed (see dev/STYLE-i18n.md for the grammar)."
		status=1
	fi
fi

if [ -n "$masters" ]; then
	# shellcheck disable=SC2086
	if ! $PY scripts/lint-agda.py $masters; then
		echo ""
		echo "Agda code lint failed (see dev/STYLE-agda.md): the OPTIONS header,"
		echo "the using-list discipline, import necessity, or a forbidden construct."
		status=1
	fi
fi

if [ -n "$md" ]; then
	# shellcheck disable=SC2086
	if ! $PY scripts/check-glossary.py --check $md; then
		echo ""
		echo "Glossary check failed: an off-glossary term rendering was used."
		echo "Fix it to the canonical rendering in dev/glossary.toml, or mark a genuine"
		echo "exception with <!-- glossary-ignore --> on the line."
		status=1
	fi
fi

# Whole-tree invariants the per-file checks cannot see. Cheap enough for the hook: it
# reads the masters' fences, it does not typecheck. The closure check is the one that
# matters here, because an unwired master is invisible to the single trusted gate.
#
# Run it ONLY when the commit touches src/. The check is whole-tree, so a concurrent
# agent's half-finished new master would otherwise block an unrelated docs commit, which
# it did the first day it existed. A commit that stages no master cannot break closure,
# and `make check` still runs the whole thing before the gate.
srcstaged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^src/' || true)
if [ -n "$srcstaged" ] && ! $PY scripts/check-tree.py --check; then
	echo ""
	echo "Whole-tree check failed. The closure case is the important one: a master that is"
	echo "not imported by src/Everything.lagda.md is never typechecked, and make check still"
	echo "goes green (dev/PLAN.md section 7 rule 3)."
	status=1
fi

[ "$status" -ne 0 ] && echo "(To bypass: git commit --no-verify)"
exit $status
