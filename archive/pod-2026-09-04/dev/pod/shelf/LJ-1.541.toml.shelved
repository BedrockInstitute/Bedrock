]
reopen = "Reopen if a consumer needs `domAt-at-carve` at LJ-1.541's own frame rather than LJ-1.559's trimmed one, and a measurement shows the two frames are not interchangeable at that consumer. R-42 predicts that ascription does not finish, so the reopen condition is a measured counterexample to that prediction, not a wish to try again."
by = "mathematician"
