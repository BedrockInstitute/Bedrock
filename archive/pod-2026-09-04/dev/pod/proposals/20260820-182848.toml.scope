# Maintainer batch 20260820-182848. NO ROWS.
#
# Five parked tasks. No row releases them. AD1: a row that would close a
# park by skipping R4, or that would re-dispatch a scene isolation cannot
# re-measure, is not written.

# ---------------------------------------------------------------------------
# 1. LJ-1.386. reason `no-change`. record None. 0 changed files.
#
# Re-accept on the main tree wiped fact 4 (seq 234). Rule (a2) skips a park
# with `t.record is None` (`scripts/pod/pod.py`). A same-code `[[queue]]` is
# skipped because the code is already a task. `resume --retry` is the owner's.
#
# ---------------------------------------------------------------------------
# 2. LJ-1.390, LJ-1.391, LJ-1.395. reason `no-match`.
#
# Stored records predate fact 8: `obligations_open` is absent.
# `sys-obligations-satisfied` therefore cannot reach them
# (`scripts/pod/table.py` `matches()`, A23). Conjuncts 1-6 held, exit 0,
# delta 0. Their `go` rows key `obligations_delta_max = -1` and miss.
#
# They have no worktree. Isolation therefore does not re-accept
# (`reaccept: no isolated scene`). A task-scoped `done` row would pass
# replay, then (a2) would move PARKED to CHECKING and park again for no
# scene. That is a worse park, not a close.
#
# ---------------------------------------------------------------------------
# 3. LJ-1.419. reason `r4`. row `task-lj-1-419-no-go-stated`.
#
# MEASURED at `.pod-state/worktrees/LJ-1-419/agents/tasks/LJ-1-419/runs/accept-1.out`:
# conjunct 1 FAILED, 2-5 held, 6 FAILED. exit 42, error_class `unsolved_meta`,
# review-of-bound-into-ord.md present. The `no-go-stated` when-clause matched.
# R4 for `outcome = no-go` requires conjuncts 5 and 6. Conjunct 6 failed, so
# the handler parked `r4` (`scripts/pod/pod.py` around the r4_holds check).
#
# `sys-lint-accept` keys `error_class = lint`. Conjunct 1 supplies
# `unsolved_meta`, so that system row cannot see this return. An
# `action = accept` task row with the same when-clause as `no-go-stated`
# would still match after conjunct 6 is repaired (exit 42 and the review
# file remain), and would loop until `attempt_max`. A `done` row that
# does not require R4's conjunct 6 would close a return the survey gate
# refused. Neither is written.
#
# The worktree is kept. Transition 14 re-accepts the same scene and will
# r4 again until a worker writes `## ARCHIVE USED`. That is `--retry`,
# which is the owner's.
#
# ---------------------------------------------------------------------------
# 4. Expiry fallout. NO ROW.
#
# Closed-task rows dying with their tasks, section 4.6. Green closes fall
# to `sys-obligations-satisfied`. That is A23. No-go closes fall to NO
# MATCH because their keys were task-scoped. Neither is a gap a new row
# should fill.

[batch]
ts = "20260820-182848"
rows_proposed = 0
reason = "LJ-1.386 is a no-change park with no record, so a2 skips it. LJ-1.390, 391 and 395 still predate fact 8, have no worktree, and a done row would re-dispatch into no isolated scene. LJ-1.419 matched no-go-stated then parked r4 because conjunct 6 failed; sys-lint-accept cannot see unsolved_meta, and an accept row with the same when-clause would loop. Expiry fallout onto sys-obligations-satisfied is A23 working."
