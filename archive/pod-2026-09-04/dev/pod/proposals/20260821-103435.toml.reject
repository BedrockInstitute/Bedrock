# Maintainer batch 20260821-103435. One row, no [[queue]].
#
# LJ-1.440, LJ-1.444: PARKED reason `admission`, permanently, since 02:32Z and
# 02:33Z. Root cause found and FIXED in scripts/pod/table.py (commit 09b2089,
# reload requested this batch's own tick): admit_rows()'s rebuild-on-every-
# dispatch logic dropped EVERY row in a task's scope, including this
# maintainer's stop-stated rows, then tried to re-add only the brief's own
# branches; R3 correctly refused the resulting deletion (it moves live corpus
# records), and the refusal repeated on every retry, so the "admission" park
# never cleared on its own (unlike every other admission park). No table row
# fixes this: it is a code defect, now fixed, and both tasks self-heal on the
# next table write once the reload lands. No row for either.
#
# LJ-1.448: PARKED `attempt_max:task-lj-1-448-stop-stated`. This is the
# already-reported re-escalation loop (backlog item 20's addendum): its own
# admitted row has no changed_files_none exclusion, so the critic's own
# return (review-of-LJ-1-448-*.md present, exit 0, obligations_open 1) also
# matched task-lj-1-448-stop-stated and re-escalated three times before
# attempt_max parked it. That row cannot be edited (rows are permanent). The
# row below is NOT a new judgement: it applies the ALREADY-RULED
# sys-critic-upheld-no-go shape (owner 2026-08-20: critic UPHELD NO-GO closes
# done/no-go) at task:LJ-1.448 scope, priority 11, so it wins the task-vs-
# system precedence tie section 4.4 gives task-lj-1-448-stop-stated (priority
# 12) over the system row. It matches ONLY a return that already carries the
# critic's own file (review-of-LJ-*-*.md), so it cannot fire on a first-time
# coder stop and cannot re-loop.

[[row]]
id = "task-lj-1-448-critic-upheld-no-go"
scope = "task:LJ-1.448"
priority = 11
action = "done"
outcome = "no-go"
added = 2026-08-21
added_by = "maintainer"
reason = "sys-critic-upheld-no-go's shape at task scope, outranks task-lj-1-448-stop-stated (priority 12) once the critic's own file is present. Closes the attempt_max park without re-escalating."
expired = false

  [row.when]
  exit_code = 0
  heap_wall = false
  obligations_open_min = 1
  changed_files_any = ["agents/tasks/LJ-1-448/review-of-LJ-*-*.md"]

[batch]
ts = "20260821-103435"
rows_proposed = 1
reason = "LJ-1.440/444's admission park is a code defect, fixed this tick (table.py, commit 09b2089); no row needed, they self-heal. LJ-1.448's attempt_max park gets one task-scoped row applying the established sys-critic-upheld-no-go decision at higher priority than its own broken stop-stated row, closing it without new judgement."
