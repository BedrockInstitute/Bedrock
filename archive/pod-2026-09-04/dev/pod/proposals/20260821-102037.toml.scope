# Maintainer batch 20260821-102037. Two rows (LJ-1.440, LJ-1.444), fixed
# shape; LJ-1.443 skipped.
#
# The mathematician's own backlog item 20 (dev/pod/maintainer-backlog.md, this
# maintainer's copy, written 2026-08-21) confirms the routing decision
# (escalate to mathematician_adversarial on a D-10-stop-exits-0 record) but its
# proposed row shape is missing a `changed_files_none` exclusion: on LJ-1.448
# (dev/pod/table.toml:4896-4909), the critic's OWN return also carries the
# coder's leftover review-of-*.md file, so it re-matched the same row and
# re-escalated itself (dev/pod/transitions/2026-08.jsonl:957, second
# mathematician_adversarial dispatch at :961). Both rows below add the
# exclusion so the critic's own file (review-of-LJ-*-*.md) stops the row from
# matching, and sys-critic-upheld-no-go takes over to close.
#
# LJ-1.440: same shape as before, unchanged.
#
# LJ-1.444, NEW no-match. Worktree report (.pod-state/worktrees/LJ-1-444/
# agents/tasks/LJ-1-444/lj-1.444-report.md:26-30): D-10 stop, worktree forked
# before LJ-1.442 landed in the main tree. UNLIKE LJ-1.443, this premise is
# NOT permanently false: LJ-1.442 is DONE/GO in the main tree
# (dev/pod/table.toml, task-lj-1-442-go). A critic re-reading the current tree
# can actually resolve this one rather than uphold a stale stop, so escalating
# is the right move, not a wasted round.
#
# LJ-1.443: NOT repeated. Per the mathematician's own note, its D-10 gate reads
# LJ-1.440's report and requires GO; LJ-1.440 genuinely returned NO-GO (not a
# stale-worktree artifact), so that gate can only ever fail. LJ-1.443 is
# superseded by LJ-1.449 (same obligation, gate re-pointed at the DONE/GO
# LJ-1.445). Unparking it with this row would spend an escalation round on a
# dead task. Settling it needs the owner's --retry, not a row.

[[row]]
id = "task-lj-1-440-stop-stated"
scope = "task:LJ-1.440"
priority = 12
action = "escalate"
head_slot = "mathematician_adversarial"
added = 2026-08-21
added_by = "maintainer"
reason = "D-10 stop, exits 0, matches no exit_code 42 branch. Same shape as dev/pod/table.toml:4896-4909 (task-lj-1-448-stop-stated) and confirmed by the mathematician's own backlog item 20. changed_files_none added: LJ-1.448's identical row (without this exclusion) re-matched the critic's own return and re-escalated itself (dev/pod/transitions/2026-08.jsonl:957,961)."
expired = false

  [row.when]
  exit_code = 0
  obligations_delta_min = 0
  changed_files_any = ["agents/tasks/LJ-1-440/review-of-*.md"]
  changed_files_none = ["agents/tasks/LJ-1-440/review-of-LJ-*-*.md"]

[[row]]
id = "task-lj-1-444-stop-stated"
scope = "task:LJ-1.444"
priority = 12
action = "escalate"
head_slot = "mathematician_adversarial"
added = 2026-08-21
added_by = "maintainer"
reason = "Same shape: D-10 stop, worktree forked before LJ-1.442 (its premise) landed GO in the main tree (.pod-state/worktrees/LJ-1-444/agents/tasks/LJ-1-444/lj-1.444-report.md:26-30). Unlike LJ-1.443, the premise is now true in the main tree, so escalation lets a critic actually resolve it rather than uphold a stale stop. changed_files_none added for the same reason as task-lj-1-440-stop-stated."
expired = false

  [row.when]
  exit_code = 0
  obligations_delta_min = 0
  changed_files_any = ["agents/tasks/LJ-1-444/review-of-*.md"]
  changed_files_none = ["agents/tasks/LJ-1-444/review-of-LJ-*-*.md"]

[batch]
ts = "20260821-102037"
rows_proposed = 2
reason = "task-lj-1-440-stop-stated and task-lj-1-444-stop-stated, both with a changed_files_none exclusion the mathematician's own template (backlog item 20) lacks, to avoid the re-escalation loop measured live on LJ-1.448. LJ-1.443 skipped: its D-10 gate is permanently unsatisfiable (LJ-1.440 genuinely NO-GO), superseded by LJ-1.449, needs owner --retry rather than a row."
