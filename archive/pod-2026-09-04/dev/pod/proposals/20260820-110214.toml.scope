# Maintainer batch 20260820-110214. NO ROWS.
#
# Four parked tasks. No row releases them.
#
# ---------------------------------------------------------------------------
# 1. LJ-1.386. reason `no-change`. No facts, 0 changed files.
#
# Re-accept on the main tree (no worktree) returned empty fact 4. R7 wiped the
# record (seq 234). Rule (a2) skips a park with `t.record is None`
# (`scripts/pod/pod.py:3222-3223`). A same-code `[[queue]]` is skipped because
# the code is already a task. `resume --retry` is the owner's, and the last
# resume did not name this code.
#
# ---------------------------------------------------------------------------
# 2. LJ-1.390, LJ-1.391, LJ-1.395. reason `no-match`.
#
# Unchanged from the last four batches. Their stored records predate fact 8, so
# `sys-obligations-satisfied` cannot reach them (`scripts/pod/table.py:563-566`).
# They have no worktree. Re-accept therefore does not run (isolation: conjunct 5
# on the main tree stopped the loop on LJ-1.388). A task-scoped `done` row would
# pass replay and then rule (a2) would re-dispatch a worker.
#
# ---------------------------------------------------------------------------
# 3. Expiry fallout. NO ROW.
#
# Closed-task rows dying with their tasks, section 4.6. c-220, c-225, c-245 and
# c-247 now fall to `sys-obligations-satisfied`. That is A23: a system row still
# matches a green close after the task row expires. It is not a gap a new row
# should fill.

[batch]
ts = "20260820-110214"
rows_proposed = 0
reason = "LJ-1.386 is a no-change park with no record, so a2 skips it. LJ-1.390, 391 and 395 still predate fact 8, have no worktree, and a done row would re-dispatch. Expiry fallout onto sys-obligations-satisfied is A23 working."
