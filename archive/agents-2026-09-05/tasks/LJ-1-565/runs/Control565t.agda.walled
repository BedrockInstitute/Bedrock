-- [LJ-1.565] CONTROL t.  CONTROL s's ROW, WITHOUT A PATH IN `IsOrd`.
-- Control s transported the ordinal-hood proof with `isProp→PathP` and
-- then read `isL-ord` along the path: HEAP WALL, 278.51 s.  Here the
-- two hierarchies are identified by the CHAPTER'S UNIQUENESS LAW and
-- the only transports left have `Lset` applied to the moving variable,
-- where it is opaque and the transport is stuck.

HB-succ-transp : (δ γ : V ℓ) (oδ : IsOrd δ) (oγ : IsOrd γ)
                 (e : sucV δ ≡ γ)
               → HierBelow (sucV δ) (suc-ord oδ) → HierBelow γ oγ
HB-succ-transp δ γ oδ oγ e h = step2
  where
  Kδ : S
  Kδ = hierL (sucV δ) (isL-ord (sucV δ) (suc-ord oδ)) (suc-ord oδ)

  specγ : IsHier γ Kδ
  specγ = subst (λ B → IsHier B Kδ) e
            (hierL-spec (sucV δ) (isL-ord (sucV δ) (suc-ord oδ))
                        (suc-ord oδ))

  same : Kδ ≡ hierL γ (isL-ord γ oγ) oγ
  same = hier-unique γ Kδ (hierL γ (isL-ord γ oγ) oγ) specγ
           (hierL-spec γ (isL-ord γ oγ) oγ)

  step1 : ⟨ fst (hierL γ (isL-ord γ oγ) oγ) ∈ Lset (step 3 (sucV δ)) ⟩
  step1 = subst (λ u → ⟨ fst u ∈ Lset (step 3 (sucV δ)) ⟩) same h

  step2 : HierBelow γ oγ
  step2 = subst (λ w → ⟨ fst (hierL γ (isL-ord γ oγ) oγ)
                          ∈ Lset (step 3 w) ⟩) e step1
