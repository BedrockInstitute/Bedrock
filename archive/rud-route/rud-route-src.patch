+           → h₀ p r pr ≡ h₀ p r' pr' → r ≡ r'
+    h₀-inj = AbstractH₀.h₀-inj (⟪ α ⟫) (⟪ α ⟫↪) (↪-inj {a = α}) _≺'_ γp (⟪_⟫) (⟪_⟫↪) fiber fst∈sucmax snd∈sucmax
+
