+            (y∈ : ⟨ y ∈ˢ C ⟩)
+          → ⟨ z ∈ˢ Fof op1 a b ⟩
+          → ⟨ (PK.pt z z∈ ∷ PK.pt b b∈ ∷ PK.pt a a∈ ∷ PK.pt y y∈ ∷ []) ⊨ᵐ mem1 ⟩
+  mem1-in z b a y z∈ b∈ a∈ y∈ h =
+    F1-spec a b z .fst (subst (λ w → ⟨ z ∈ˢ w ⟩) (Fof-f1 a b) h)
