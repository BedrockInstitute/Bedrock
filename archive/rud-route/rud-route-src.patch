+      (g-inj p (b∈ m) (b∈ n)
+        (h₀-inj p (snd (descent p (⟪ α ⟫↪ m) (b∈ m)) .fst)
+                  (snd (descent p (⟪ α ⟫↪ n) (b∈ n)) .fst) e'))
+      where
+      b∈ : (m : ⟪ α ⟫) → ⟨ ⟪ α ⟫↪ m ∈ˢ colA p ⟩
+      b∈ m = subst (λ w → ⟨ ⟪ α ⟫↪ m ∈ˢ w ⟩) (sym e)
+        (∈∈ₛ {a = ⟪ α ⟫↪ m} {b = α} .snd (∈ₛ⟪ α ⟫↪ m))
