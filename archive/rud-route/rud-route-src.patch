+  mem1-out : (z b a y : S) (z∈ : ⟨ z ∈ˢ C ⟩) (b∈ : ⟨ b ∈ˢ C ⟩) (a∈ : ⟨ a ∈ˢ C ⟩)
+             (y∈ : ⟨ y ∈ˢ C ⟩)
+           → ⟨ (PK.pt z z∈ ∷ PK.pt b b∈ ∷ PK.pt a a∈ ∷ PK.pt y y∈ ∷ []) ⊨ᵐ mem1 ⟩
+           → ⟨ z ∈ˢ Fof op1 a b ⟩
