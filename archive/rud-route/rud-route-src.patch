+            , subst (λ u → ⟨ envOne u ∈ fst (Sat (toS ψ)) ⟩) qm
+                (inSat ψ m ∣ (m , hm) , refl ∣₁)
+
+        back : (y : S) → Holds y → ⟨ fst y ∈ fst z ⟩
+        back y (yw , ys) = subst (λ X → ⟨ fst y ∈ X ⟩) qz
+          (subst (λ u → ⟨ u ∈ DA.defSet ψ ⟩) (fib .snd)
+            (outSat ψ (fib .fst)
+              (subst (λ u → ⟨ envOne u ∈ fst (Sat (toS ψ)) ⟩)
