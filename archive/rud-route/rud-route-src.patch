+          (subst (λ w → ⟨ x ∈ˢ w ⟩) (cc p) x∈)))
+      where
+      viaUnion : Σ[ v ∈ S ] (⟨ v ∈ₛ sett PairA (gₚ p) ⟩ × ⟨ x ∈ₛ v ⟩) → ⟨ x ∈ˢ α ⟩
+      viaUnion (v , (v∈ₛsett , x∈ₛv)) = PT.rec (snd (x ∈ˢ α)) viaFiber
+        (∈∈ₛ {a = v} {b = sett PairA (gₚ p)} .snd v∈ₛsett)
+        where
