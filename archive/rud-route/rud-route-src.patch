+    col∈α : (p : PairA) → ⟨ colA p ∈ˢ α ⟩
+    col∈α = WF.induction {P = λ p → ⟨ colA p ∈ˢ α ⟩} step
+      where
+      step : (p : PairA) → ((r : PairA) → r ≺' p → ⟨ colA r ∈ˢ α ⟩)
+           → ⟨ colA p ∈ˢ α ⟩
