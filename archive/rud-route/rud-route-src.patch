+    Empty.rec (¬m<m {toℕ i} (≤-trans (≤-trans q2 (≤-sucℕ {n})) r))
+  decodeTm-kept s m n e e' m<s m≤n n≥1 i q1 q2 l | eq r =
+    Empty.rec (¬m<m {toℕ i} (subst (λ w → suc (toℕ i) ≤ w) (sym r) q1))
+  decodeTm-kept s m n e e' m<s m≤n n≥1 i q1 q2 l | gt r =
+    Empty.rec (¬m<m {toℕ i}
