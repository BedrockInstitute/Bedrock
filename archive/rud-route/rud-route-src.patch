+                   (snd (envOne (fst y) ∈ fst (Sat (toS ψ)))))
+          step (subst (λ X → ⟨ fst y ∈ X ⟩) (sym qz) y∈)
+          where
+          step : Fibre ψ (fst y) → Holds y
