+  mem0-in : (z b a y : S) (z∈ : ⟨ z ∈ˢ C ⟩) (b∈ : ⟨ b ∈ˢ C ⟩) (a∈ : ⟨ a ∈ˢ C ⟩)
+            (y∈ : ⟨ y ∈ˢ C ⟩)
+          → ⟨ z ∈ˢ Fof op0 a b ⟩
+          → ⟨ (PK.pt z z∈ ∷ PK.pt b b∈ ∷ PK.pt a a∈ ∷ PK.pt y y∈ ∷ []) ⊨ᵐ mem0 ⟩
+  mem0-in z b a y z∈ b∈ a∈ y∈ h =
+    F0-spec a b z .fst (subst (λ w → ⟨ z ∈ˢ w ⟩) (Fof-f0 a b) h)
