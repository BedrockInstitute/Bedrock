+            ⟨ pr (⟪ ⋃ (⋃ a) ⟫↪ u) (⟪ ⋃ (⋃ a) ⟫↪ v) ∈ₛ a ⟩ ]
+           (⟪ ⋃ (⋃ a) ⟫↪ (p .fst) ≡ x)
+       → ∥ Σ[ u ∈ V ℓ ] Σ[ v ∈ V ℓ ]
+            (⟨ pr u v ∈ˢ a ⟩ × ⟨ x ≡ₕ u ⟩) ∥₁
+    go (p , q) = ∣ ⟪ ⋃ (⋃ a) ⟫↪ (p .fst) , ⟪ ⋃ (⋃ a) ⟫↪ (p .snd .fst)
+      , ( ∈∈ₛ {a = pr (⟪ ⋃ (⋃ a) ⟫↪ (p .fst)) (⟪ ⋃ (⋃ a) ⟫↪ (p .snd .fst))}
+              {b = a} .snd (p .snd .snd)
+        , subst (λ w → ⟨ x ≡ₕ w ⟩) (sym q) refl ) ∣₁
