+      ∣ fst δm , (snd δm , isOrd-out zero (δm ∷ f ∷ ι x ∷ []) ord
+        , in-part , out-part) ∣₁
+      where
+      in-part : (a : S) → ⟨ a ∈ˢ fst δm ⟩ → ∥ Σ[ b ∈ S ] ⟨ pr a b ∈ˢ fst f ⟩ ∥₁
+      in-part a a∈δ = PT.rec squash₁ go (in-sat am a∈δ)
