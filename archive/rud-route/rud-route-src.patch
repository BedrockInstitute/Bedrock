+open import L.Rud.OrdArith {ℓ} lem using
+  ( isLimit; isLimit-ord; isLimit-not-zero; isSucc; limit-mem-ord; ord-case )
+open import L.Rud.OrdBlocks {ℓ} lem using
+  ( +ω; +ω-limit; +ω-in; +ω-out; +ω-ord; sucIter )
