+  -- The exact domain bound: satisfaction is the exactness decode.
+  exactDom-out : (f : SM) (x : ⟪ u ⟫)
+               → ⟨ (f ∷ ι x ∷ []) ⊨ᵐ exactDomForm ⟩ → exactDom (fst f)
+  exactDom-out f x h = PT.rec squash₁ step h
+    where
+    step : Σ[ δm ∈ SM ]
