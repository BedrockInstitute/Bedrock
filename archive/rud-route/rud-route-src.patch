+            yS = y , isL-trans {x = fst z} {y = y} y∈ (snd z)
+
+            cond : ⟨ y ∈ fst (lookup w γ) ⟩ × ⟨ envOne y ∈ fst v ⟩
+            cond = DefinesAt-out (suc (suc zero)) (sh3 w) zero δ hdef yS y∈
+
+            fib : Σ[ m ∈ ⟪ fst A ⟫ ] (ιA m ≡ y)
