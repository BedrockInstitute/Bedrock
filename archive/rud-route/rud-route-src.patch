+  decodeTm-kept s m n e e' m<s m≤n n≥1 i q1 q2 l | lt _ | lt r =
+    cong₂ _,_
+      (cong (λ q → var {K = K} (fromℕ' n (toℕ i) q)) (isProp≤ r q2)) refl
