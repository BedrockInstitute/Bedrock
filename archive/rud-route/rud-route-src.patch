+  suc⁴∈ γ ζ limγ ζ∈γ = limit-succ-mem γ _ limγ (limit-succ-mem γ _ limγ
+    (limit-succ-mem γ _ limγ (limit-succ-mem γ ζ limγ ζ∈γ)))
