+      Tξ∈L : ⟨ Tξ ∈ˢ Lset (sucV (sucV (sucV ξ))) ⟩
+      Tξ∈L = subst (λ w → ⟨ w ∈ˢ Lset (sucV (sucV (sucV ξ))) ⟩) (sym pr≡F0)
+        (Lpair (sucV (sucV ξ)) (F0 ξ ξ) (F0 ξ (Sset ξ)) F0ξξ∈L F0ξSξ∈L)
+
+      F0TT∈L : ⟨ F0 Tξ Tξ ∈ˢ Lset (sucV (sucV (sucV (sucV ξ)))) ⟩
