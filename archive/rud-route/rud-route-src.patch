+          → ∥ Σ[ u ∈ V ℓ ] Σ[ v ∈ V ℓ ]
+               (⟨ u ∈ˢ a ⟩ × ⟨ v ∈ˢ a ⟩ × ⟨ u ∈ˢ v ⟩ × ⟨ x ≡ₕ pr u v ⟩) ∥₁
+  F7-read a b x h = PT.rec squash₁ go h
+    where
+    go : Σ[ p ∈ Σ[ q ∈ ⟪ a ⟫ × ⟪ a ⟫ ]
+            ⟨ ⟪ a ⟫↪ (q .fst) ∈ₛ ⟪ a ⟫↪ (q .snd) ⟩ ]
+           (pr (⟪ a ⟫↪ (p .fst .fst)) (⟪ a ⟫↪ (p .fst .snd)) ≡ x)
+       → ∥ Σ[ u ∈ V ℓ ] Σ[ v ∈ V ℓ ]
+            (⟨ u ∈ˢ a ⟩ × ⟨ v ∈ˢ a ⟩ × ⟨ u ∈ˢ v ⟩ × ⟨ x ≡ₕ pr u v ⟩) ∥₁
+    go (p , q) = ∣ ⟪ a ⟫↪ (p .fst .fst) , ⟪ a ⟫↪ (p .fst .snd)
