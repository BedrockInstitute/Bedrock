+      where
+      go : (⟨ colA p ∈ˢ α ⟩ ⊎ ((colA p ≡ α) ⊎ ⟨ α ∈ˢ colA p ⟩)) → ⟨ colA p ∈ˢ α ⟩
+      go (inl h) = h
+      go (inr (inl e)) = Empty.rec (exclude p e)
+      go (inr (inr h)) = Empty.rec (∈-irrefl α (colp⊆α p rec α h))
