+      go (inr s) = inr (subst (λ w → z ≡ pr a w) er
+        (PK.prAt-out f2 f4 f0
+          (PK.pt r r∈ ∷ PK.pt l l∈ ∷ PK.pt z z∈ ∷ PK.pt b b∈
+           ∷ PK.pt a a∈ ∷ PK.pt y y∈ ∷ []) s))
