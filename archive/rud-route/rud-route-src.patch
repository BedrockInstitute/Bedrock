+      go : Σ[ n ∈ ℕ ] (γp p ≡ # n) → Empty.⊥
+      go (n , q) = ∈-irrefl ω
+        (subst (λ w → ⟨ w ∈ˢ ω ⟩) (sym (cong sucV q) ∙ e) (#∈ω (suc n)))
